
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 6,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "network",
        "cpu",
        "memory",
        "pulseaudio",
        "battery",
        "tray",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{id}",
        "sort-by-number": true,
        "disable-scroll": true,
        "on-click": "activate"
    },

    "clock": {
        "interval": 1,
        "format": "{:%H:%M  /  %d.%m.%Y}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "nmtui"
    },

    "cpu": {
        "interval": 2,
        "format": "󰻠 {usage}%",
        "tooltip": true
    },

    "memory": {
        "interval": 2,
        "format": "󰍛 {}%",
        "tooltip": true
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "tooltip": true
    },

    "battery": {
        "states": {
            "warning": 50,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": [
            "󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾",
            "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
        ],
        "tooltip": true
    },

    "tray": {
        "icon-size": 16,
        "spacing": 6
    },

    "custom/power": {
        "exec": "echo ''",
        "interval": "once",
        "format": "{}",
        "tooltip": true,
        "tooltip-format": "Power menu",
        "on-click": "bash -c '$HOME/.config/waybar/scripts/power-menu'"
    }
}
